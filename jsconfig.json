{
   "compilerOptions": {
      "allowJs": true,
      "checkJs": true,
      "noEmit": true,
      "strict": true,
      "target": "ES2022",
      "module": "ESNext",
      "moduleResolution": "Bundler",
      "lib": [
         "ES2022",
         "DOM"
      ],
      "types": [
         "alpinejs"
      ]
   },
   "include": [
      "js/**/*.js",
      "types/**/*.d.ts"
   ]
}
